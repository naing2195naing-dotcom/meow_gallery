<div class="container py-5">
  <div class="meow-card mx-auto" style="max-width: 450px;">

    <div class="text-center mb-4">
      <div class="display-4 mb-2">🐾</div>
      <h2 class="fw-bold">新規会員登録</h2>
      <p class="text-muted">
        Meow Gallery の仲間になりましょう！
      </p>
    </div>

    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <h6 class="fw-bold">入力内容を確認してください</h6>
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path do |form| %>

      <div class="mb-3">
        <%= form.label :name,
                       "ユーザー名",
                       class: "form-label fw-bold" %>

        <%= form.text_field :name,
                            required: true,
                            placeholder: "ユーザー名を入力",
                            class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :email_address,
                       "メールアドレス",
                       class: "form-label fw-bold" %>

        <%= form.email_field :email_address,
                             required: true,
                             autocomplete: "email",
                             placeholder: "example@email.com",
                             class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :password,
                       "パスワード",
                       class: "form-label fw-bold" %>

        <%= form.password_field :password,
                                required: true,
                                autocomplete: "new-password",
                                placeholder: "パスワードを入力",
                                class: "form-control" %>
      </div>

      <div class="mb-4">
        <%= form.label :password_confirmation,
                       "パスワード（確認）",
                       class: "form-label fw-bold" %>

        <%= form.password_field :password_confirmation,
                                required: true,
                                autocomplete: "new-password",
                                placeholder: "もう一度パスワードを入力",
                                class: "form-control" %>
      </div>

      <div class="d-grid">
        <%= form.submit "新規登録",
                        class: "btn btn-meow" %>
      </div>

    <% end %>

    <hr class="my-4">

    <div class="text-center">
      <p class="small">
        すでにアカウントをお持ちの方
      </p>

      <%= link_to "ログイン",
                  new_session_path,
                  class: "btn btn-outline-secondary w-100" %>
    </div>

  </div>
</div>
