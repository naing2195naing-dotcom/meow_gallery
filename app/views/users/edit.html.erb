<div class="container py-5">
  <div class="meow-card mx-auto" style="max-width: 600px;">

    <div class="text-center mb-4">
      <h2 class="fw-bold mb-4">プロフィール編集 🐾</h2>

      <% if @user.profile_image.attached? %>
        <%= image_tag @user.profile_image,
                      width: 120,
                      height: 120,
                      class: "rounded-circle shadow-sm",
                      style: "object-fit: cover;",
                      alt: "プロフィール画像" %>
      <% else %>
        <%= image_tag "no_image.png",
                      width: 120,
                      height: 120,
                      class: "rounded-circle shadow-sm",
                      style: "object-fit: cover;",
                      alt: "デフォルトプロフィール画像" %>
      <% end %>
    </div>

    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <h6 class="fw-bold">入力内容を確認してください</h6>
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user do |form| %>

      <div class="mb-3">
        <%= form.label :name,
                       "ユーザー名",
                       class: "form-label fw-bold" %>

        <%= form.text_field :name,
                            required: true,
                            class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :email_address,
                       "メールアドレス",
                       class: "form-label fw-bold" %>

        <%= form.email_field :email_address,
                             required: true,
                             class: "form-control" %>
      </div>

      <div class="mb-4">
        <%= form.label :profile_image,
                       "プロフィール画像",
                       class: "form-label fw-bold" %>

        <%= form.file_field :profile_image,
                            accept: "image/jpeg,image/png,image/webp",
                            class: "form-control" %>

        <div class="form-text">
          JPEG・PNG・WebP形式（5MB以下）
        </div>
      </div>

      <div class="d-grid">
        <%= form.submit "変更を保存",
                        class: "btn btn-meow" %>
      </div>

    <% end %>

    <div class="mt-3">
      <%= link_to "プロフィールに戻る",
                  user_path(@user),
                  class: "btn btn-outline-secondary w-100" %>
    </div>

    <hr class="my-4">

    <div class="border border-danger rounded-3 p-3">
      <h5 class="text-danger fw-bold">
        アカウント削除
      </h5>

      <p class="small text-muted">
        アカウントを削除すると元に戻せません。
      </p>

      <%= button_to "アカウントを削除",
                    user_path(@user),
                    method: :delete,
                    class: "btn btn-outline-danger w-100",
                    form: {
                      data: {
                        turbo_confirm: "本当にアカウントを削除しますか？"
                      }
                    } %>
    </div>

  </div>
</div>
